// Entry template for the Sort-Seq Analysis block.
//
//   1. resolve the inputs against the abundance anchor              (wf.prepare)
//   2. export the reads and variants tables                         (body)
//   3. write the parameter document                                 (body)
//   4. invoke the score entrypoint once                             (body)
//   5. construct one PColumn per file the manifest names            (build-columns.tpl)
//
// Stage 5 is a child template because a body finishes building its graph before the tool
// runs, so the manifest cannot be branched on inline.
//
// THIS TEMPLATE MUST NOT:
//   * apply the read floor, here or in the export — depths must be taken pre-floor, or two
//     floor settings become incomparable;
//   * pair, order or relate conditions;
//   * decide which columns exist or what they declare. The manifest supplies both.

wf := import("@platforma-sdk/workflow-tengo:workflow")
exec := import("@platforma-sdk/workflow-tengo:exec")
assets := import("@platforma-sdk/workflow-tengo:assets")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
render := import("@platforma-sdk/workflow-tengo:render")
canonical := import("@platforma-sdk/workflow-tengo:canonical")

scoreSw := assets.importSoftware("@platforma-open/milaboratories.sort-seq-analysis.software:main")
buildColumnsTpl := assets.importTemplate(":build-columns")

// Headers the computation reads; fixed here and in software/src/constants.py together.
READS_FILE := "reads.tsv"
VARIANTS_FILE := "variants.tsv"
POSITIONS_FILE := "positions.tsv"
PARAMS_FILE := "params.json"
MANIFEST_FILE := "manifest.json"
SORT_FRACTION_HEADER := "sortFraction"

// Collected by pattern because the caller cannot name them up front: it does not know which
// conditions survive exclusion, nor where binScore is produced.
SCORE_FILE_REGEX := "^score_.*\\.tsv$"
DISTRIBUTION_FILE_REGEX := "^dist_.*\\.tsv$"
// The only output not keyed on the variant axis, so it gets its own set rather than a
// `score_` name.
BASELINE_FILE_REGEX := "^baseline_.*\\.tsv$"

wf.prepare(func(args) {
	bb := wf.createPBundleBuilder()
	bb.ignoreMissingDomains()

	// The anchor: every other input resolves against it, so columns cannot be mixed across runs.
	//
	// It MUST be named "main" — the model's stored anchored ids embed `{"anchor":"main"}`, and
	// any other name fails with "anchor 'main' not found". Part of the id's contract.
	bb.addAnchor("main", args.abundanceRef)

	// One predicate, one option list, three independent picks: no spec predicate can tell which
	// role a metadata column plays, so the user assigns them.
	bb.addSingle(args.conditionColumnRef, "condition")
	bb.addSingle(args.gateColumnRef, "gate")
	if !is_undefined(args.sortFractionColumnRef) {
		bb.addSingle(args.sortFractionColumnRef, "sortFraction")
	}

	// The variants' mutation count. The grain follows the dataset and is deliberately NOT
	// pinned to an alphabet — see `mutationCountSelector` in the model.
	//
	// Matched as a column, never the mutation-count AXIS of the same name.
	//
	// addMulti because the predicate may resolve to nothing, and because several matches are
	// treated as no answer — so a predicate that broadened too far runs with none.
	bb.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/repertoire/mutationCount"
	}, "mutationCount")

	// The variant's own nucleotide sequence — the whole input the codon facts need.
	//
	// Pinned to the nucleotide alphabet, which is what makes "resolved" mean "this run is at
	// nucleotide grain". On an amino-acid dataset it resolves to nothing and the computation
	// reports `no-sequence-column`.
	bb.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		name: "pl7.app/sequence",
		domain: {
			"pl7.app/feature": "amplicon-sequence",
			"pl7.app/alphabet": "nucleotide"
		}
	}, "sequence")

	// Every linker touching the variant axis. `partialAxesMatch` is required: a linker has two
	// axes and only one is the anchor's, so an exact-axes selector matches nothing.
	//
	// The body reads `aaToNt`'s OTHER axis, which is the amino-acid variant axis the rolled-up
	// scores are keyed on. It is reachable no other way.
	bb.addMulti({
		axes: [{ anchor: "main", idx: 1 }],
		annotations: { "pl7.app/isLinkerColumn": "true" },
		partialAxesMatch: true
	}, "linkers")

	// The parent's residue at each reference position, [parentId, position] -> residue.
	//
	// Matched on name and alphabet alone: it shares NO axis with the anchor, so it cannot be
	// anchored. Safe because several matches are treated as no answer, so two profiler runs on
	// one project produce no per-position output rather than the wrong run's.
	bb.addMulti({
		name: "pl7.app/repertoire/parentResidue",
		domain: { "pl7.app/alphabet": "aminoacid" }
	}, "parentResidue")

	// Full await (spec and data) delays this block's spec emission, but the body exports these
	// columns' values as tables, so it genuinely consumes the data.
	return { columns: bb.build() }
})

wf.body(func(args) {
	blockId := wf.blockId().getDataAsJson()
	columns := args.columns

	abundanceSpec := columns.getSpec("main")
	sampleAxisSpec := abundanceSpec.axesSpec[0]
	variantAxisSpec := abundanceSpec.axesSpec[1]

	hasSortFraction := !is_undefined(args.sortFractionColumnRef)

	// More than one match is no answer: no first-match, no ranking. A tie-break would be this
	// block's invention.
	mutationCountColumns := columns.getColumns("mutationCount")
	hasMutationCount := !is_undefined(mutationCountColumns) && len(mutationCountColumns) == 1

	sequenceColumns := columns.getColumns("sequence")
	hasSequence := !is_undefined(sequenceColumns) && len(sequenceColumns) == 1

	// The amino-acid variant axis, via the nt->aa linker.
	//
	// Both variant axes are named `pl7.app/variantKey` and differ only in the
	// `pl7.app/alphabet` domain, so this compares DOMAINS. Comparing names picks whichever
	// axis came first.
	proteinAxisSpec := undefined
	proteinLinker := undefined
	linkerColumns := columns.getColumns("linkers")
	if !is_undefined(linkerColumns) {
		for col in linkerColumns {
			if len(col.spec.axesSpec) != 2 {
				continue
			}
			for axis in col.spec.axesSpec {
				if axis.name == variantAxisSpec.name &&
					!is_undefined(axis.domain) &&
					axis.domain["pl7.app/alphabet"] == "aminoacid" &&
					variantAxisSpec.domain["pl7.app/alphabet"] == "nucleotide" {
					proteinAxisSpec = axis
					proteinLinker = col
				}
			}
		}
	}
	// Roll-up happens exactly when the protein is knowable. Not a user setting.
	rollUp := !is_undefined(proteinAxisSpec)

	// Both candidate axes go to the child, which picks on the manifest's `rolledUp` — the
	// computation's own answer, never a second inference from the linker. Deciding it here
	// declares an axis the emitted keys may not match, and the table still renders.

	parentResidueColumns := columns.getColumns("parentResidue")
	hasParentResidue := !is_undefined(parentResidueColumns) && len(parentResidueColumns) == 1

	//////// Stage 2: two tables, because the inputs sit on two grains ////////

	// Joined on shared axes: abundance ([sample][variant]) plus metadata ([sample]) gives one
	// row per (sample, variant).
	readsBuilder := pframes.tsvFileBuilder()
	readsBuilder.setAxisHeader(sampleAxisSpec.name, "sampleId")
	readsBuilder.setAxisHeader(variantAxisSpec.name, "variantKey")
	readsBuilder.add(columns.getColumn("main"), { header: "reads" })
	readsBuilder.add(columns.getColumn("condition"), { header: "condition" })
	readsBuilder.add(columns.getColumn("gate"), { header: "gate" })
	if hasSortFraction {
		readsBuilder.add(columns.getColumn("sortFraction"), { header: SORT_FRACTION_HEADER })
	}
	readsBuilder.mem("16GiB")
	readsBuilder.cpu(1)
	readsTsv := readsBuilder.build()

	// A second table because the count is per variant: in the reads table it would repeat per
	// sample, and its absence would be a null column rather than a missing table. The sequence
	// rides here too — same key, and its presence is what marks the nucleotide grain.
	variantsTsv := undefined
	if hasMutationCount {
		variantsBuilder := pframes.tsvFileBuilder()
		variantsBuilder.setAxisHeader(variantAxisSpec.name, "variantKey")
		variantsBuilder.add(mutationCountColumns[0], { header: "mutationCount" })
		if hasSequence {
			variantsBuilder.add(sequenceColumns[0], { header: "sequence" })
		}
		if rollUp {
			// The linker's value is a sentinel; the AXIS is what we want. Heading it puts the
			// protein key in its own column, one per nucleotide variant.
			//
			// Disambiguated by axis spec, not name: both are `pl7.app/variantKey`.
			variantsBuilder.setAxisHeader(proteinAxisSpec, "proteinKey")
			variantsBuilder.add(proteinLinker, { header: "link" })
		}
		variantsBuilder.mem("8GiB")
		variantsBuilder.cpu(1)
		variantsTsv = variantsBuilder.build()
	}

	// Exported only on exactly one match, which is the only case the computation can align its
	// own codon numbering against.
	positionsTsv := undefined
	if hasParentResidue {
		positionsBuilder := pframes.tsvFileBuilder()
		positionsBuilder.setAxisHeader("pl7.app/repertoire/parentId", "parentId")
		positionsBuilder.setAxisHeader("pl7.app/repertoire/position", "position")
		positionsBuilder.add(parentResidueColumns[0], { header: "residue" })
		positionsBuilder.mem("4GiB")
		positionsBuilder.cpu(1)
		positionsTsv = positionsBuilder.build()
	}

	//////// Stage 3: the parameter document ////////

	// Omitted rather than nulled; the computation reads an absent key as the behaviour.
	paramsPayload := {
		gateRanks: args.gateRanks,
		excludedConditions: args.excludedConditions
	}
	if !is_undefined(args.readFloor) {
		paramsPayload.readFloor = args.readFloor
	}
	if hasSortFraction {
		paramsPayload.sortFractionColumn = SORT_FRACTION_HEADER
	}
	// Same rule, so a gate-ranking run writes the byte-identical document it always has and
	// every cached result survives the upgrade. `inputGate` travels with `mode`.
	if !is_undefined(args.mode) {
		paramsPayload.mode = args.mode
		paramsPayload.inputGate = args.inputGate
	}
	if !is_undefined(args.baseline) {
		paramsPayload.baseline = args.baseline
	}
	if !is_undefined(args.baselineSequence) {
		paramsPayload.baselineSequence = args.baselineSequence
	}

	//////// Stage 4: one invocation, covering every condition ////////

	// One call for every condition: nothing outside the arithmetic is per-condition.
	execBuilder := exec.builder().
		software(scoreSw).
		mem("16GiB").
		cpu(4).
		writeFile(PARAMS_FILE, canonical.encode(paramsPayload)).
		addFile(READS_FILE, readsTsv).
		arg("--reads").arg(READS_FILE).
		arg("--params").arg(PARAMS_FILE).
		arg("--out-dir").arg(".").
		saveFileSet("scoreFiles", SCORE_FILE_REGEX).
		saveFileSet("distributionFiles", DISTRIBUTION_FILE_REGEX).
		saveFileSet("baselineFiles", BASELINE_FILE_REGEX).
		saveFileContent(MANIFEST_FILE).
		saveStdoutStream()

	if hasMutationCount {
		execBuilder.addFile(VARIANTS_FILE, variantsTsv)
		execBuilder.arg("--variants").arg(VARIANTS_FILE)
	}
	if hasParentResidue {
		execBuilder.addFile(POSITIONS_FILE, positionsTsv)
		execBuilder.arg("--positions").arg(POSITIONS_FILE)
	}

	score := execBuilder.run()

	//////// Stage 5: construct the columns the manifest names ////////

	// Ephemeral because the child reads the manifest's VALUE, which needs `awaitState`. Only
	// this step opts out of dedup; everything expensive above it stays pure.
	built := render.createEphemeral(buildColumnsTpl, {
		manifest: score.getFileContent(MANIFEST_FILE),
		scoreFiles: score.getFileSet("scoreFiles"),
		distributionFiles: score.getFileSet("distributionFiles"),
		// Both axes; the child picks on the manifest's `rolledUp`.
		variantAxisSpec: variantAxisSpec,
		proteinAxisSpec: proteinAxisSpec,
		// The per-gate distribution stays on the dataset's own variant axis: it draws the
		// variants that were measured, not the proteins they were pooled into.
		measuredAxisSpec: variantAxisSpec,
		parentIdAxisSpec: hasParentResidue ? parentResidueColumns[0].spec.axesSpec[0] : undefined,
		positionAxisSpec: hasParentResidue ? parentResidueColumns[0].spec.axesSpec[1] : undefined,
		baselineFiles: score.getFileSet("baselineFiles"),
		abundanceSpec: abundanceSpec,
		blockId: blockId
	})

	return {
		outputs: {
			// Distribution columns go to the graph frame only, not exports or the pool: a pool
			// column is a contract, and this diagnostic's form is still open.
			//
			// The scored columns go to both the frame and exports — one import, two destinations.
			scoresPf: built.output("scoresPfForUi"),
			distributionPf: built.output("distributionPf"),
			// Returned as an output of its own so what it reports about the run is readable
			// without reconstructing it from the columns.
			manifest: score.getFileContent(MANIFEST_FILE),
			logHandle: score.getStdoutStream()
		},
		exports: {
			// The two scored columns, and those stay the whole of what another block consumes.
			pf: built.output("scoresPf")
		}
	}
})
