// Construct one PColumn per file the manifest names.
//
// A child template because it reads the manifest's VALUE, which the entry body cannot: its
// graph is built before the entrypoint runs.
//
// Rendered with `render.createEphemeral` — `awaitState` is allowed only in ephemeral
// templates, and a pure `render.create` compiles clean and dies on the first real run.
//
// EVERY DECLARED VALUE COMES FROM THE MANIFEST, NEVER FROM THE BLOCK'S ARGUMENTS. Deriving
// `sortYieldCorrected` from "did the user pick a column" would emit "true" over an
// uncorrected number if the column were dropped from the export.
//
// Spec keys are written as literals: a Tengo map literal treats a bare identifier as the key
// itself, so a named constant in key position emits the constant's NAME.

self := import("@platforma-sdk/workflow-tengo:tpl")
xsv := import("@platforma-sdk/workflow-tengo:pframes.xsv")
pframes := import("@platforma-sdk/workflow-tengo:pframes")
pSpec := import("@platforma-sdk/workflow-tengo:pframes.spec")
maps := import("@platforma-sdk/workflow-tengo:maps")
strings := import("@platforma-sdk/workflow-tengo:strings")
ll := import("@platforma-sdk/workflow-tengo:ll")
json := import("json")

self.defineOutputs("scoresPf", "scoresPfForUi", "distributionPf")

self.awaitState("manifest", "ResourceReady")
self.awaitState("scoreFiles", "ResourceReady")
self.awaitState("distributionFiles", "ResourceReady")
self.awaitState("baselineFiles", "ResourceReady")

self.body(func(inputs) {
	// saveFileContent produces a binary value resource rather than a typed JSON one, so the
	// template unmarshaller hands it over untouched and the decode is ours.
	manifest := inputs.manifest.getDataAsJson()

	// A file set arrives as a map of file name -> file resource.
	scoreFiles := inputs.scoreFiles
	distributionFiles := inputs.distributionFiles

	// `variantAxisSpec` is the dataset's own grain; `proteinAxisSpec` carries the rolled-up
	// level beside it. The axis follows the manifest, never whether the linker resolved —
	// inferring it declares an axis the emitted keys may not match, and it still renders.
	variantAxisSpec := inputs.variantAxisSpec
	proteinAxisSpec := inputs.proteinAxisSpec
	measuredAxisSpec := inputs.measuredAxisSpec

	// Read off the axes rather than assumed: on an amino-acid dataset the measured level
	// already IS protein.
	measuredAlphabet := "aminoacid"
	if !is_undefined(variantAxisSpec.domain) && !is_undefined(variantAxisSpec.domain["pl7.app/alphabet"]) {
		measuredAlphabet = variantAxisSpec.domain["pl7.app/alphabet"]
	}
	parentIdAxisSpec := inputs.parentIdAxisSpec
	positionAxisSpec := inputs.positionAxisSpec
	baselineFiles := inputs.baselineFiles
	blockId := inputs.blockId

	// Kill switch for every baseline-derived column. The computation resolves the baseline and
	// writes its files either way, and the manifest reports it either way — only the columns
	// are withheld when this is false.
	//
	// It must hold the same value as `BASELINE_AVAILABLE` in the model. True here alone and the
	// columns claim a baseline the user was never offered; true there alone and the user picks a
	// baseline that emits nothing.
	EMIT_BASELINE_COLUMNS := true

	// Appended to the mean-bin descriptions, so a mean bin of 2.6 can be placed on the ladder
	// without opening the settings. Not on the vs-parent scores: those are a difference in gate
	// steps, which no single rung on the ladder corresponds to. The computation renders the list;
	// a rank is a JSON number here and Tengo's string form for one is not worth relying on.
	ladderNote := ""
	if !is_undefined(manifest.gateLadder) && manifest.gateLadder != "" {
		ladderNote = " Gates: " + manifest.gateLadder + "."
	}

	// Carries no rank: the ordering is the declared gate order, applied when the view draws.
	gateAxisSpec := {
		name: "pl7.app/facsBin/gate",
		type: "String",
		domain: {
			"pl7.app/block": blockId
		},
		annotations: {
			"pl7.app/label": "Gate"
		}
	}

	// makeTrace bundles the upstream abundance provenance with this block's own step;
	// trace.inject then rewrites only the small spec resources.
	trace := pSpec.makeTrace(inputs.abundanceSpec, {
		type: "milaboratories.sort-seq-analysis",
		importance: 30,
		label: "Sort-Seq Analysis"
	})

	// For the columns read against the baseline. Claimed ONLY when it resolved. The plain
	// enrichment is always against the input, so it says "input" whatever the baseline: naming
	// the baseline there would claim a reference the value does not use, and would move the
	// column's identity whenever the user changed the baseline.
	enrichmentReference := "input"
	if !is_undefined(manifest.baselineOption) && manifest.baselineIdentified {
		enrichmentReference = manifest.baselineOption
	}

	scoreEntries := {}
	distributionEntries := {}

	// `id` is the frame entry key and must be unique per condition, or the second import
	// overwrites the first.
	importOne := func(file, valueColumn, id, valueSpec, axes) {
		return xsv.importFile(file, "tsv", {
			axes: axes,
			columns: [{ column: valueColumn, id: id, spec: valueSpec }],
			storageFormat: "Parquet",
			partitionKeyLength: 0
		}, { splitDataAndSpec: true, cpu: 1, mem: "8GiB" })
	}

	collect := func(target, imported) {
		// Sorted: add() order feeds the frame's resource CID, and Tengo map iteration is not
		// order-guaranteed — an unsorted loop gives a CIDConflictError on re-render.
		for key in maps.getKeys(imported) {
			ll.assert(is_undefined(target[key]), "duplicate pframe entry key: %v", key)
			target[key] = imported[key]
		}
	}

	for entry in manifest.conditions {
		condition := entry.condition

		// Substituted HERE and only here. The condition DOMAIN value below is verbatim: a
		// substituted value joins back to nothing in the source metadata column.
		suffix := strings.substituteSpecialCharacters(condition)

		// Always written, including when false: absence is ambiguous between "uncorrected"
		// and "produced by a nucleotide variant that did not record it".
		sortYieldCorrected := entry.sortYieldCorrected ? "true" : "false"

		variantAxes := [{ column: "variantKey", spec: variantAxisSpec }]

		// Keyed on the variant axis and nothing else; a condition is never an axis, and samples
		// are consumed into gates and conditions.
		//
		// The axis is propagated verbatim from the abundance column, never constructed: a
		// hand-built one resolves against the wrong variant axis on some projects.
		// Absent where the gates carry no order: a rank mean would claim one.
		if !is_undefined(entry.gateRankMeanFile) {
		collect(scoreEntries, importOne(
			scoreFiles[entry.gateRankMeanFile],
			"gateRankMean",
			"gateRankMean_" + suffix,
			{
				name: "pl7.app/facsBin/gateRankMean",
				valueType: "Double",
				domain: {
					"pl7.app/block": blockId,
					"pl7.app/facsBin/condition": condition,
					"pl7.app/alphabet": measuredAlphabet
				},
				annotations: {
					"pl7.app/label": "Mean Bin (" + condition + ")",
					"pl7.app/format": ".2f",
					"pl7.app/isScore": "true",
					// "decreasing" means higher-is-favourable in the ranking path. It reads like
					// the opposite; the UI names the option "Highest".
					"pl7.app/score/rankingOrder": "decreasing",
					// Header tooltip in the results table. Kept to one plain sentence.
					"pl7.app/description": "The average gate this variant's reads landed in, weighted by reads. Higher means stronger binding, on an uncalibrated scale." + ladderNote,
					"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
					"pl7.app/table/visibility": "default",
					"pl7.app/table/orderPriority": "70100"
				}
			},
			variantAxes
		))
		}

		// Not built at all rather than built empty: an empty column would claim every variant
		// was unscorable here.
		if !is_undefined(entry.binScoreFile) {
			collect(scoreEntries, importOne(
				scoreFiles[entry.binScoreFile],
				"binScore",
				"binScore_" + suffix,
				{
					name: "pl7.app/facsBin/binScore",
					valueType: "Double",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/facsBin/condition": condition,
						"pl7.app/alphabet": measuredAlphabet,
						// Only binScore carries it: gateRankMean is independent of the parent
						// reference, so a mode on it claims a distinction it does not have.
						"pl7.app/facsBin/referenceMode": entry.referenceMode
					},
					annotations: {
						"pl7.app/label": "Mean Bin vs Parent (" + condition + ")",
						"pl7.app/format": "+.2f",
						"pl7.app/isScore": "true",
						"pl7.app/score/rankingOrder": "decreasing",
						"pl7.app/description": "This variant's mean bin minus the parent's, in gate steps. Zero means it behaves like the parent.",
						"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
						"pl7.app/table/visibility": "default",
						"pl7.app/table/orderPriority": "70200"
					}
				},
				variantAxes
			))
		}

		// One column per (condition, gate), keyed on the variant axis ALONE with the gate in the
		// domain. Empty outside enrichment mode.
		//
		// The gate is a domain key, not an axis: the Mutation Explorer's score picker only sees
		// columns keyed on the variant axis, so a gate axis hides these behind one selector
		// instead of giving each gate its own map.
		//
		// The read distribution below does use a real gate axis — there the gate is the
		// dimension being plotted, not part of the column's identity.
		for gate in entry.gateEnrichments {
			// The string() cast is required: json.encode returns bytes, and bytes inside a map
			// that is encoded again come out base64'd with no error anywhere.
			gateAnnotations := {
				"pl7.app/label": "Enrichment " + gate.gate + " (" + condition + ")",
				"pl7.app/format": ".3~g",
				"pl7.app/isScore": "true",
				"pl7.app/score/rankingOrder": "decreasing",
				"pl7.app/description": "How much this variant is enriched in this gate relative to the unsorted input — 1 means no change, above 1 means enriched.",
				"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
				"pl7.app/table/visibility": "default",
				"pl7.app/table/orderPriority": "70300"
			}

			// Annotations rather than a new output, so centring a colour scale needs no second
			// query. Absent rather than zero: a zero level is a baseline measured at complete
			// depletion.
			// Present only where the run has one parent — the computation leaves `baseline`
			// unset on a multi-parent run, where the column above carries every parent's.
			if !is_undefined(gate.baseline) {
				gateAnnotations["pl7.app/facsBin/baselineLevel"] = string(json.encode(gate.baseline.level))
				gateAnnotations["pl7.app/facsBin/baselineVariants"] = string(json.encode(gate.baseline.variants))
			}

			collect(scoreEntries, importOne(
				scoreFiles[gate.file],
				"gateEnrichment",
				// Suffixed by the gate value, not the rank: a JSON number's Tengo string form is
				// not worth relying on for an id.
				"gateEnrichment_" + suffix + "_" + strings.substituteSpecialCharacters(gate.gate),
				{
					name: "pl7.app/facsBin/gateEnrichment",
					valueType: "Double",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/facsBin/condition": condition,
						"pl7.app/alphabet": measuredAlphabet,
						// Verbatim, as the condition is: a consumer matches on it and a
						// substituted value would join back to nothing in the gate column.
						"pl7.app/facsBin/gate": gate.gate,
						"pl7.app/facsBin/referenceMode": "input"
					},
					annotations: gateAnnotations
				},
				variantAxes
			))

			// The per-gate baseline, one row per parent, on [parentId] alone.
			//
			// Emitted on every run rather than only a multi-parent one, so consumers read one
			// shape. The annotations above carry the same numbers where the run has a single
			// parent and are omitted where it has several — one annotation cannot describe
			// several baselines, and this column can.
			if EMIT_BASELINE_COLUMNS && !is_undefined(parentIdAxisSpec) && !is_undefined(gate.baselineGateFile) {
				// The level is the number; the count says how much to trust it, so it travels
				// beside it rather than only in the manifest.
				for quantity in [
					{ column: "baselineLevel", id: "gateBaselineLevel_", name: "pl7.app/facsBin/gateBaselineLevel", type: "Double", fmt: ".3~g", label: "Baseline ", desc: "Where a variant of no effect sits in this gate, measured on this parent's own baseline set. The median, because an enrichment has a long tail.", show: "default", order: "70350" },
					{ column: "baselineVariants", id: "gateBaselineVariants_", name: "pl7.app/facsBin/gateBaselineVariants", type: "Int", fmt: ",d", label: "Baseline Variants ", desc: "How many of this parent's baseline variants survived the read floor here and backed the level beside it.", show: "optional", order: "70353" }
				] {
					collect(scoreEntries, importOne(
						baselineFiles[gate.baselineGateFile],
						quantity.column,
						quantity.id + suffix + "_" + strings.substituteSpecialCharacters(gate.gate),
						{
							name: quantity.name,
							valueType: quantity.type,
							domain: {
								"pl7.app/block": blockId,
								"pl7.app/facsBin/condition": condition,
								"pl7.app/facsBin/gate": gate.gate,
								"pl7.app/facsBin/referenceMode": enrichmentReference
							},
							annotations: {
								"pl7.app/label": quantity.label + gate.gate + " (" + condition + ")",
								"pl7.app/format": quantity.fmt,
								"pl7.app/description": quantity.desc,
								"pl7.app/table/visibility": quantity.show,
								"pl7.app/table/orderPriority": quantity.order
							}
						},
						[{ column: "parentId", spec: parentIdAxisSpec }]
					))
				}
			}

			// On [parentId, position] — the shape the heat map already resolves.
			//
			// Axes propagated verbatim from the profiler's parent-residue column: a hand-built
			// position axis carries this block's numbering and joins to nothing. A file only
			// reaches here once the computation verified its offsets against those labels.
			if EMIT_BASELINE_COLUMNS && !is_undefined(parentIdAxisSpec) && !is_undefined(gate.baselinePositionFile) {
				baselineAxes := [
					{ column: "parentId", spec: parentIdAxisSpec },
					{ column: "position", spec: positionAxisSpec }
				]
				collect(scoreEntries, importOne(
					baselineFiles[gate.baselinePositionFile],
					"baselineLevel",
					"baselineLevel_" + suffix + "_" + strings.substituteSpecialCharacters(gate.gate),
					{
						name: "pl7.app/facsBin/baselineLevel",
						valueType: "Double",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/facsBin/condition": condition,
							"pl7.app/facsBin/gate": gate.gate,
							"pl7.app/facsBin/referenceMode": enrichmentReference
						},
						annotations: {
							"pl7.app/label": "Baseline " + gate.gate + " (" + condition + ")",
							"pl7.app/format": ".3~g",
							"pl7.app/description": "The enrichment of the parent's synonymous variants at this position — where a variant of no effect sits.",
							"pl7.app/table/visibility": "optional",
							"pl7.app/table/orderPriority": "70400"
						}
					},
					baselineAxes
				))
			}
		}

		// ---- The protein level, beside the measured one -------------------------------
		//
		// Present only where the computation pooled. Same names and condition domain as the
		// measured columns, told apart by the amino-acid alphabet and a different axis.
		if !is_undefined(entry.rolled) && !is_undefined(proteinAxisSpec) {
			proteinAxes := [{ column: "variantKey", spec: proteinAxisSpec }]

			if !is_undefined(entry.rolled.gateRankMeanFile) {
			collect(scoreEntries, importOne(
				scoreFiles[entry.rolled.gateRankMeanFile],
				"gateRankMean",
				"gateRankMeanAa_" + suffix,
				{
					name: "pl7.app/facsBin/gateRankMean",
					valueType: "Double",
					domain: {
						"pl7.app/block": blockId,
						"pl7.app/facsBin/condition": condition,
						"pl7.app/alphabet": "aminoacid"
					},
					annotations: {
						"pl7.app/label": "Mean Bin (" + condition + ")",
						"pl7.app/format": ".2f",
						"pl7.app/isScore": "true",
						"pl7.app/score/rankingOrder": "decreasing",
						"pl7.app/description": "The average gate this protein sorted into, pooled over its synonymous nucleotide variants." + ladderNote,
						"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
						"pl7.app/table/visibility": "default",
						"pl7.app/table/orderPriority": "70100"
					}
				},
				proteinAxes
			))
			}

			// The same reference at protein grain: each protein against its own parent's protein.
			// It carries no baseline band — the synonymous variants were pooled into the parent
			// protein, so there is no set left to measure noise from here. The band stays on the
			// nucleotide table, where it was measured.
			if !is_undefined(entry.rolled.binScoreFile) {
				collect(scoreEntries, importOne(
					scoreFiles[entry.rolled.binScoreFile],
					"binScore",
					"binScoreAa_" + suffix,
					{
						name: "pl7.app/facsBin/binScore",
						valueType: "Double",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/facsBin/condition": condition,
							"pl7.app/alphabet": "aminoacid",
							"pl7.app/facsBin/referenceMode": entry.rolled.referenceMode
						},
						annotations: {
							"pl7.app/label": "Mean Bin vs Parent (" + condition + ")",
							"pl7.app/format": "+.2f",
							"pl7.app/isScore": "true",
							"pl7.app/score/rankingOrder": "decreasing",
							"pl7.app/description": "This protein's mean bin minus the parent protein's, in gate steps. Zero means it behaves like the parent.",
							"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
							"pl7.app/table/visibility": "default",
							"pl7.app/table/orderPriority": "70200"
						}
					},
					proteinAxes
				))
			}

			if !is_undefined(entry.rolled.gateRankMeanFile) {
			for quantity in [
				{ column: "uncertainty", id: "gateRankMeanUncertaintyAa_", name: "pl7.app/facsBin/gateRankMeanUncertainty", type: "Double", fmt: ".3f", label: "Mean Bin Error (", desc: "The larger of the counting error and the disagreement between this protein's nucleotide variants.", order: "70150" },
				{ column: "ntVariants", id: "gateRankMeanNtVariantsAa_", name: "pl7.app/facsBin/ntVariants", type: "Int", fmt: ",d", label: "NT Variants (", desc: "How many of this protein's nucleotide variants passed the read floor and entered the error estimate.", order: "70160" }
			] {
				collect(scoreEntries, importOne(
					scoreFiles[entry.rolled.gateRankMeanFile],
					quantity.column,
					quantity.id + suffix,
					{
						name: quantity.name,
						valueType: quantity.type,
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/facsBin/condition": condition,
							"pl7.app/alphabet": "aminoacid"
						},
						annotations: {
							"pl7.app/label": quantity.label + condition + ")",
							"pl7.app/format": quantity.fmt,
							"pl7.app/min": "0",
							"pl7.app/description": quantity.desc,
							"pl7.app/table/visibility": "optional",
							"pl7.app/table/orderPriority": quantity.order
						}
					},
					proteinAxes
				))
			}
			}

			for gate in entry.rolled.gateEnrichments {
				gateAnno := {
					"pl7.app/label": "Enrichment " + gate.gate + " (" + condition + ")",
					"pl7.app/format": ".3~g",
					"pl7.app/isScore": "true",
					"pl7.app/score/rankingOrder": "decreasing",
					"pl7.app/description": "How much this protein is enriched in this gate relative to the unsorted input, from the reads of all its nucleotide variants pooled.",
					"pl7.app/facsBin/sortYieldCorrected": sortYieldCorrected,
					"pl7.app/table/visibility": "default",
					"pl7.app/table/orderPriority": "70300"
				}
				if !is_undefined(gate.baseline) {
					gateAnno["pl7.app/facsBin/baselineLevel"] = string(json.encode(gate.baseline.level))
					gateAnno["pl7.app/facsBin/baselineVariants"] = string(json.encode(gate.baseline.variants))
				}
				collect(scoreEntries, importOne(
					scoreFiles[gate.file],
					"gateEnrichment",
					"gateEnrichmentAa_" + suffix + "_" + strings.substituteSpecialCharacters(gate.gate),
					{
						name: "pl7.app/facsBin/gateEnrichment",
						valueType: "Double",
						domain: {
							"pl7.app/block": blockId,
							"pl7.app/facsBin/condition": condition,
							"pl7.app/alphabet": "aminoacid",
							"pl7.app/facsBin/gate": gate.gate,
							"pl7.app/facsBin/referenceMode": "input"
						},
						annotations: gateAnno
					},
					proteinAxes
				))

				// Both ride in the same file as the enrichment, and exist only at this level:
				// a per-variant enrichment has no nucleotide variants to disagree.
				for quantity in [
					{ column: "uncertainty", id: "gateEnrichmentUncertaintyAa_", name: "pl7.app/facsBin/gateEnrichmentUncertainty", type: "Double", fmt: ".3~g", label: "Enrichment Error ", desc: "The standard error of the enrichment, in the same units: the larger of the counting error and the disagreement between this protein's nucleotide variants. Below about 20 reads it understates the error; check the read counts.", order: "70310" },
					{ column: "ntVariants", id: "gateEnrichmentNtVariantsAa_", name: "pl7.app/facsBin/gateEnrichmentNtVariants", type: "Int", fmt: ",d", label: "Enrichment NT Variants ", desc: "How many of this protein's nucleotide variants passed the read floor and entered the error estimate.", order: "70320" }
				] {
					collect(scoreEntries, importOne(
						scoreFiles[gate.file],
						quantity.column,
						quantity.id + suffix + "_" + strings.substituteSpecialCharacters(gate.gate),
						{
							name: quantity.name,
							valueType: quantity.type,
							domain: {
								"pl7.app/block": blockId,
								"pl7.app/facsBin/condition": condition,
								"pl7.app/alphabet": "aminoacid",
								"pl7.app/facsBin/gate": gate.gate,
								"pl7.app/facsBin/referenceMode": "input"
							},
							annotations: {
								"pl7.app/label": quantity.label + gate.gate + " (" + condition + ")",
								"pl7.app/format": quantity.fmt,
								"pl7.app/min": "0",
								"pl7.app/description": quantity.desc,
								"pl7.app/table/visibility": "optional",
								"pl7.app/table/orderPriority": quantity.order
							}
						},
						proteinAxes
					))
				}
			}
		}

		// Two Double columns per condition on [variant, gate]. Neither is a score, so neither
		// carries the score annotations. Without the condition key every condition's pair has
		// an identical spec and they collide.
		distributionAxes := [
			{ column: "variantKey", spec: measuredAxisSpec },
			{ column: "gate", spec: gateAxisSpec }
		]

		collect(distributionEntries, importOne(
			distributionFiles[entry.readDistributionFile],
			"gateFrequency",
			"gateFrequency_" + suffix,
			{
				name: "pl7.app/facsBin/gateFrequency",
				valueType: "Double",
				domain: {
					"pl7.app/block": blockId,
					"pl7.app/facsBin/condition": condition
				},
				annotations: {
					"pl7.app/label": "Gate Read Frequency (" + condition + ")",
					"pl7.app/format": ".3~g",
					"pl7.app/table/visibility": "optional"
				}
			},
			distributionAxes
		))

		// Both travel: four reads and four thousand draw the same profile.
		collect(distributionEntries, importOne(
			distributionFiles[entry.readDistributionFile],
			"gateReads",
			"gateReads_" + suffix,
			{
				name: "pl7.app/facsBin/gateReads",
				valueType: "Double",
				domain: {
					"pl7.app/block": blockId,
					"pl7.app/facsBin/condition": condition
				},
				annotations: {
					"pl7.app/label": "Gate Reads (" + condition + ")",
					"pl7.app/format": ",d",
					"pl7.app/table/visibility": "optional"
				}
			},
			distributionAxes
		))
	}

	// One row per parent, for the run rather than per condition: which parent holds how much of
	// the dataset. Emitted in every mode, so the parents are visible on a run that produces no
	// baseline — a gate-ranking run has none at all.
	if !is_undefined(parentIdAxisSpec) && !is_undefined(manifest.parentSummaryFile) {
		for quantity in [
			{ column: "parentVariants", id: "parentVariants", name: "pl7.app/facsBin/parentVariants", fmt: ",d", label: "Variants", desc: "How many variants this run scored under this parent.", order: "70010" },
			{ column: "parentReads", id: "parentReads", name: "pl7.app/facsBin/parentReads", fmt: ",d", label: "Reads", desc: "How many reads this parent's variants carry across every gate the run covers.", order: "70020" }
		] {
			collect(scoreEntries, importOne(
				scoreFiles[manifest.parentSummaryFile],
				quantity.column,
				quantity.id,
				{
					name: quantity.name,
					valueType: "Int",
					domain: { "pl7.app/block": blockId },
					annotations: {
						"pl7.app/label": quantity.label,
						"pl7.app/format": quantity.fmt,
						"pl7.app/description": quantity.desc,
						"pl7.app/table/visibility": "default",
						"pl7.app/table/orderPriority": quantity.order
					}
				},
				[{ column: "parentId", spec: parentIdAxisSpec }]
			))
		}
	}

	buildFrame := func(entries) {
		builder := pframes.pFrameBuilder()
		for key in maps.getKeys(entries) {
			value := entries[key]
			builder.add(key, trace.inject(value.spec), value.data)
		}
		return builder.build()
	}

	// One frame, two destinations. `scoresPfForUi` exists because the result pool cannot tell
	// this instance's columns from another instance of this block's.
	scores := buildFrame(scoreEntries)

	return {
		scoresPf: scores,
		scoresPfForUi: pframes.exportFrame(scores),
		distributionPf: pframes.exportFrame(buildFrame(distributionEntries))
	}
})
